meta {
  name: Rate address
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/addresses/{{addressId}}/rating
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "rating": 4
  }
}

vars:pre-request {
  addressId: 
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("returns updated rating", function() {
    expect(res.getBody().item.rating).to.equal(4);
  });
}
