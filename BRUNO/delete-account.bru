meta {
  name: Delete account
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/api/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("returns confirmation message", function() {
    expect(res.getBody()).to.have.property("message");
  });
}