meta {
  name: Search addresses by proximity
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/addresses/searches
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "radius": 10,
    "from": {
      "lat": 48.8584,
      "lng": 2.2945
    }
  }
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("returns items array", function() {
    expect(res.getBody()).to.have.property("items");
  });
}