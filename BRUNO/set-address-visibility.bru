meta {
  name: Set address visibility
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/addresses/{{addressId}}/visibility
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "isPublic": true
  }
}

vars:pre-request {
  addressId: 54
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("returns updated visibility", function() {
    expect(res.getBody().item.isPublic).to.equal(true);
  });
}
