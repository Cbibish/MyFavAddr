meta {
  name: Create user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: none
}

body:json {
  {
    "email": "test@test.com",
    "password": "supersecret"
  }
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("returns user item", function() {
    expect(res.getBody()).to.have.property("item");
  });
}
